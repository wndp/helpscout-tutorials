{
    "name": "wndp/helpscout-tutorials",
    "description": "HelpScout Docs tutorial-maintenance toolchain: download, edit, publish, create.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Wndp\\HelpScoutTutorials\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wndp\\HelpScoutTutorials\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wndp\\HelpScoutTutorials\\HelpScoutTutorialsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
